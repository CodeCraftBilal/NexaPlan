DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_project_manager?schema=public"
JWT_SECRET="super-secret-jwt-key-change-in-production"
# Optional: the rest of the app works without AI configured.
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-OPENAI-api-key-here"
# Optional override: openai or gemini. Otherwise prefer a configured OpenAI key.
# AI_PROVIDER="openai"
OPENAI_MODEL="gpt-4.1-mini"
GEMINI_MODEL="gemini-2.5-flash"
CLIENT_URL="http://localhost:3000"
PORT=5000
NODE_ENV="development"
